{
  "name": "@open-ota/server",
  "version": "0.1.0",
  "description": "Open OTA server \u2014 Device API, Admin API, MCP endpoint. Runs on Node, Deno (Supabase Edge) and Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entry/node.ts",
    "start": "node dist/entry/node.js",
    "build": "esbuild src/entry/node.ts --bundle --platform=node --format=esm --outfile=dist/entry/node.js --banner:js='import{createRequire as __cr}from\"node:module\";const require=__cr(import.meta.url);'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "demo": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@open-ota/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
