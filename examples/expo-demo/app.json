{
  "expo": {
    "name": "Open OTA Demo",
    "slug": "open-ota-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "otademo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.openota.demo",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.openota.demo"
    },
    "plugins": [
      [
        "@open-ota/react-native",
        {
          "projectId": "set-by-ota-init",
          "apiUrl": "http://192.168.1.10:3000",
          "channel": "production",
          "scheme": "otademo"
        }
      ]
    ]
  }
}
