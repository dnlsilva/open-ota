# Copy to .env before `docker compose up`. Backups are pg_dump + the bucket;
# bundles are immutable, so they never need versioning.

# ---------------------------------------------------------------- required

# Seals every project's RSA private signing key at rest (AES-256-GCM).
# Lose it and you must re-key each project and ship new binaries.
#   openssl rand -base64 32
OTA_MASTER_KEY=

POSTGRES_PASSWORD=change-me
STORAGE_SECRET_KEY=change-me-too

# ------------------------------------------------------------------ server

# self = single org, no billing, no signup after the first account.
# hosted = multi-tenant with signup, quotas and Stripe (PUBLIC_URL required).
OTA_MODE=self
PORT=3000

# Public base url of this server. Preview deep links and the OAuth metadata are
# built from it, so it has to be what clients actually type.
PUBLIC_URL=http://localhost:3000

# Origins allowed to call the admin API. `*` is fine while the server is on a
# private network; narrow it to your dashboard origin once it is exposed.
CORS_ORIGINS=*

# First boot only, and only in self mode: creates the admin account and its org
# when the users table is empty. Password needs 10+ characters.
OTA_ADMIN_EMAIL=
OTA_ADMIN_PASSWORD=

# ----------------------------------------------------------------- storage

# s3 (R2 / S3 / MinIO) · supabase · local (single-node disk, no CDN)
STORAGE_DRIVER=s3

# The one string that matters: an S3 presigned URL is signed for a specific
# host, so the CLI and the devices must reach the bucket at the SAME address
# the server signs it with. `minio` works only for server-side calls — set this
# to your machine's LAN address (http://192.168.1.10:9000) as soon as you
# publish from the CLI or download onto a device.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ota-bundles
STORAGE_ACCESS_KEY=ota-minio
# MinIO needs path-style addressing; S3 and R2 do not.
STORAGE_FORCE_PATH_STYLE=true
# Only for STORAGE_DRIVER=local.
STORAGE_LOCAL_DIR=.ota/bundles

# CDN origin in front of the bucket. Bundles are immutable, so cache hard.
# Empty = devices download straight from STORAGE_ENDPOINT, which is fine only
# if that address is reachable from the device (see the note above).
PUBLIC_BUNDLE_BASE_URL=

# STORAGE_DRIVER=supabase only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- email

# console prints the message to the server log — enough for a single-admin
# install. resend sends for real.
EMAIL_DRIVER=console
EMAIL_FROM=Open OTA <noreply@localhost>
RESEND_API_KEY=

# ----------------------------------------------------------------- billing

# OTA_MODE=hosted only. Without STRIPE_SECRET_KEY billing stays off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=

# ---------------------------------------------------------------- internal

# Set by the image; only override when serving the dashboard from elsewhere.
# DASHBOARD_DIR=/app/dashboard
# Set by compose from the values above.
# DATABASE_URL=postgres://ota:...@postgres:5432/ota
