{
  "name": "@open-ota/react-native",
  "version": "0.1.0",
  "description": "Open OTA SDK for React Native and Expo — signed OTA updates with automatic rollback",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./plugin/index.js"
  },
  "files": ["src", "plugin", "android", "ios", "expo-module.config.json", "README.md"],
  "keywords": ["react-native", "expo", "ota", "codepush", "hot-update"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=8",
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": { "optional": true },
    "@expo/config-plugins": { "optional": true }
  },
  "dependencies": {
    "@open-ota/shared": "workspace:*"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "expo-modules-core": "^2.1.1",
    "react": "^18.3.1",
    "react-native": "^0.76.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
