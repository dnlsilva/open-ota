{
  "name": "@open-ota/react-native",
  "version": "0.1.0",
  "description": "Open OTA SDK for React Native and Expo \u2014 signed OTA updates with automatic rollback",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./plugin/index.js",
    "./plugin/codemods": "./plugin/codemods/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "plugin",
    "android",
    "ios",
    "expo-module.config.json",
    "README.md"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ota",
    "codepush",
    "hot-update"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=8",
    "expo": "*",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "dependencies": {
    "@open-ota/shared": "workspace:*"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "expo-modules-core": "^57.0.15",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
